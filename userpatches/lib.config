# userpatches/lib.config
# Hooks for kernel RT patch application and configuration

# post_kernel_config is called after the kernel config has been generated
# and before the kernel is compiled. This is where we enable RT options.
post_kernel_config() {
    display_alert "Enabling PREEMPT_RT in kernel configuration" "info"

    # Ensure the kernel source scripts/config is available
    if [ -f scripts/config ]; then
        # Enable PREEMPT_RT (Real-Time) support
        scripts/config --enable CONFIG_EXPERT
        scripts/config --enable CONFIG_PREEMPT_RT
        scripts/config --disable CONFIG_PREEMPT_NONE
        scripts/config --disable CONFIG_PREEMPT_VOLUNTARY

        # Disable debug/tracing options that increase latency
        scripts/config --disable CONFIG_DEBUG_PREEMPT
        scripts/config --disable CONFIG_PROVE_LOCKING
        scripts/config --disable CONFIG_LOCKDEP
        scripts/config --disable CONFIG_DEBUG_LOCK_ALLOC
        scripts/config --disable CONFIG_LOCK_STAT
        scripts/config --disable CONFIG_FTRACE
        scripts/config --disable CONFIG_KPROBES
        scripts/config --disable CONFIG_FUNCTION_TRACER
        scripts/config --disable CONFIG_STACK_TRACER
        scripts/config --disable CONFIG_KMEMCHECK
        scripts/config --disable CONFIG_DEBUG_VM
        scripts/config --disable CONFIG_SLUB_DEBUG
        scripts/config --disable CONFIG_DEBUG_LIST
        scripts/config --disable CONFIG_DEBUG_CREDENTIALS
        scripts/config --disable CONFIG_DEBUG_PI_LIST
        scripts/config --disable CONFIG_DEBUG_INFO_REDUCED
        scripts/config --disable CONFIG_DEBUG_INFO_COMPRESSED
        scripts/config --disable CONFIG_EMBEDDED_RAMDISK

        # CPU frequency scaling: set default governor to performance
        scripts/config --disable CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND
        scripts/config --disable CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE
        scripts/config --disable CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE
        scripts/config --set-str CONFIG_CPU_FREQ_DEFAULT_GOV "performance"

        # Enable high-resolution timers
        scripts/config --enable CONFIG_HIGH_RES_TIMERS

        # Enable RCU optimizations for RT
        scripts/config --enable CONFIG_RCU_USER_QS
        scripts/config --enable CONFIG_RCU_NOCB_CPU

        # Disable cgroup options that conflict with RT
        scripts/config --disable CONFIG_CGROUPS
        scripts/config --disable CONFIG_CGROUP_DEVICE
        scripts/config --disable CONFIG_CGROUP_SCHED

        # Audio: ensure sun4i codec and I2S are enabled
        scripts/config --enable CONFIG_SND
        scripts/config --enable CONFIG_SND_SOC
        scripts/config --enable CONFIG_SND_SUN4I_CODEC
        scripts/config --enable CONFIG_SND_SUN8I_CODEC_ANALOG
        scripts/config --enable CONFIG_SND_simple_SOUND
        scripts/config --enable CONFIG_SND_SIMPLE_CARD
        scripts/config --enable CONFIG_SOUND

        # Run olddefconfig to resolve any new options introduced by RT patch
        make olddefconfig

        display_alert "All kernel RT options set and olddefconfig run" "info"
    else
        display_alert "scripts/config not found — config hooks may not apply" "warning"
    fi

    display_alert "PREEMPT_RT configuration completed" "info"
}
